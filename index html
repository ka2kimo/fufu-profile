<title>フフ。 | Profile</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0; min-height: 100vh;
  display: grid; place-items: center;
  padding: 24px 16px;
  background: #08090d; color: #f4f5f8;
  font-family: system-ui, sans-serif;
}
main {
  width: 100%; max-width: 430px;
  padding: 30px 24px;
  border: 1px solid #292d38; border-radius: 24px;
  background: linear-gradient(145deg,#12151d,#090a0f);
}
.top { color: #9299a9; font-size: 11px; letter-spacing: 3px; }
.avatar {
  width: 88px; height: 88px; margin: 30px auto 16px;
  display: grid; place-items: center;
  border: 1px solid #41485b; border-radius: 50%;
  background: #191d27; font-size: 38px;
}
h1 { text-align: center; margin: 0; font-size: 32px; }
.handle { text-align: center; color: #9299a9; margin: 8px; }
.tag {
  width: fit-content; margin: 16px auto 28px;
  padding: 7px 14px; border-radius: 30px;
  background: #191d27; color: #c8cdda; font-size: 13px;
}
hr { border: 0; border-top: 1px solid #292d38; margin: 24px 0; }
h2 { font-size: 12px; letter-spacing: 2px; color: #9299a9; }
p { color: #d0d3dc; line-height: 1.9; font-size: 14px; }
.interests { display: flex; gap: 10px; flex-wrap: wrap; }
.interests span {
  padding: 10px 13px; background: #191d27;
  border-radius: 10px; font-size: 13px;
}
a {
  display: block; margin-top: 30px; padding: 15px;
  text-align: center; text-decoration: none;
  color: #08090d; background: #f3f4f6;
  border-radius: 12px; font-weight: 700;
  transition: opacity .2s;
}
a:hover { opacity: .8; }
footer { text-align: center; color: #747c8f; font-size: 10px;
  letter-spacing: 2px; margin-top: 25px; }
</style>
</head>
<body>
<main>
  <div class="top">PERSONAL PROFILE</div>
